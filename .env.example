# Supabase database (required on Vercel; optional locally if app_db_config.json exists)
SUPABASE_DB_HOST=db.YOUR_PROJECT.supabase.co
SUPABASE_DB_PASSWORD=your-password-here
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PORT=5432

# Pooler (auto-used on Vercel for db.* hosts; override region if needed)
# SUPABASE_DB_POOLER_HOST=aws-0-eu-central-1.pooler.supabase.com
# SUPABASE_DB_POOLER_PORT=6543
# SUPABASE_PROJECT_REF=your-project-ref

# Flask session signing (required on Vercel — use a long random string)
SESSION_SECRET=generate-a-random-64-char-hex-string

# Web app passcode (default: 0170)
WEB_PASSCODE=0170
